# Generated by jenerate.py; each person generates the palettes they want.
vs-code-theme/package.json
vs-code-theme/themes/jenerated-*-color-theme.json
ptyxis-theme/*.palette
slack-theme/*.txt
tilix-theme/*.json
vim-theme/colors/jenerated-*.vim
obsidian-theme/*/
*.vsix

# Your palette draft in the Palette Creator.
palette-creator/work-in-progress-palette.toml

# Except the default palette, Blue Purple, which is committed so the themes
# work without running jenerate.py.
!vs-code-theme/package.json
!vs-code-theme/themes/jenerated-blue-purple-color-theme.json
!ptyxis-theme/blue-purple.palette
!slack-theme/blue-purple.txt
!tilix-theme/blue-purple.json
!vim-theme/colors/jenerated-blue-purple.vim
!obsidian-theme/blue-purple/

# Python bytecode (from importing jenerate.py)
__pycache__/
