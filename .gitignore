# Generated by jenerate.py; each person generates the palettes they want.
app-themes/vs-code-theme/package.json
app-themes/vs-code-theme/themes/jenerated-*-color-theme.json
app-themes/ptyxis-theme/*.palette
app-themes/slack-theme/*.txt
app-themes/tilix-theme/*.json
app-themes/vim-theme/colors/jenerated-*.vim
app-themes/obsidian-theme/*/
app-themes/firefox-theme/*/
app-themes/firefox-theme/*.xpi
app-themes/vivaldi-theme/*/
app-themes/vivaldi-theme/*.zip
app-themes/jetbrains-theme/*/
app-themes/jetbrains-theme/*.jar
*.vsix

# Your palette draft in the Palette Creator.
palette-creator/work-in-progress-palette.toml

# Except the default palette, Blue Purple, which is committed so the themes
# work without running jenerate.py.
!app-themes/vs-code-theme/package.json
!app-themes/vs-code-theme/themes/jenerated-blue-purple-color-theme.json
!app-themes/ptyxis-theme/blue-purple.palette
!app-themes/slack-theme/blue-purple.txt
!app-themes/tilix-theme/blue-purple.json
!app-themes/vim-theme/colors/jenerated-blue-purple.vim
!app-themes/obsidian-theme/blue-purple/
!app-themes/firefox-theme/blue-purple/
!app-themes/vivaldi-theme/blue-purple/
!app-themes/jetbrains-theme/blue-purple/
!app-themes/vivaldi-theme/jenerated-blue-purple.zip
!app-themes/jetbrains-theme/jenerated-blue-purple.jar

# Python bytecode (from importing jenerate.py)
__pycache__/
