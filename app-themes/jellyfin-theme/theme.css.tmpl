/* Jenerated {{name}} for Jellyfin. Generated by jenerate.py from
   theme.css.tmpl; edit the palette or template instead of this file.
   Paste it into Custom CSS code (Dashboard -> Branding for everyone, or
   Settings -> Display for one device). */

/* Jellyfin draws its colors from these variables. ":root[data-theme]"
   outranks Jellyfin's own "[data-theme=...]", so this palette wins whichever
   of Jellyfin's themes is chosen. */
:root,
:root[data-theme] {
    --jf-palette-common-white: {{text_strong}};

    --jf-palette-background-default: {{bg}};
    --jf-palette-background-defaultChannel: {{bg_rgb_spaced}};
    --jf-palette-background-paper: {{bg_widget}};
    --jf-palette-background-paperChannel: {{bg_widget_rgb_spaced}};
    --jf-palette-background-defaultImage: none;

    --jf-palette-primary-main: {{accent}};
    --jf-palette-primary-mainChannel: {{accent_rgb_spaced}};
    --jf-palette-primary-light: {{accent_hover}};
    --jf-palette-primary-lightChannel: {{accent_hover_rgb_spaced}};
    --jf-palette-primary-dark: {{accent_hover}};
    --jf-palette-primary-darkChannel: {{accent_hover_rgb_spaced}};
    --jf-palette-primary-contrastText: {{text_bright}};
    --jf-palette-primary-contrastTextChannel: {{text_bright_rgb_spaced}};

    --jf-palette-secondary-main: {{accent_soft}};
    --jf-palette-secondary-mainChannel: {{accent_soft_rgb_spaced}};
    --jf-palette-secondary-light: {{accent_pale}};
    --jf-palette-secondary-lightChannel: {{accent_pale_rgb_spaced}};
    --jf-palette-secondary-dark: {{accent_soft}};
    --jf-palette-secondary-darkChannel: {{accent_soft_rgb_spaced}};
    --jf-palette-secondary-contrastText: {{bg}};
    --jf-palette-secondary-contrastTextChannel: {{bg_rgb_spaced}};

    --jf-palette-error-main: {{red}};
    --jf-palette-error-mainChannel: {{red_rgb_spaced}};
    --jf-palette-error-light: {{term_bright_red}};
    --jf-palette-error-lightChannel: {{term_bright_red_rgb_spaced}};
    --jf-palette-error-dark: {{term_red}};
    --jf-palette-error-darkChannel: {{term_red_rgb_spaced}};
    --jf-palette-error-contrastText: {{bg}};
    --jf-palette-error-contrastTextChannel: {{bg_rgb_spaced}};

    --jf-palette-warning-main: {{yellow}};
    --jf-palette-warning-mainChannel: {{yellow_rgb_spaced}};
    --jf-palette-warning-light: {{term_bright_yellow}};
    --jf-palette-warning-lightChannel: {{term_bright_yellow_rgb_spaced}};
    --jf-palette-warning-dark: {{term_yellow}};
    --jf-palette-warning-darkChannel: {{term_yellow_rgb_spaced}};
    --jf-palette-warning-contrastText: {{bg}};
    --jf-palette-warning-contrastTextChannel: {{bg_rgb_spaced}};

    --jf-palette-info-main: {{cyan}};
    --jf-palette-info-mainChannel: {{cyan_rgb_spaced}};
    --jf-palette-info-light: {{term_bright_cyan}};
    --jf-palette-info-lightChannel: {{term_bright_cyan_rgb_spaced}};
    --jf-palette-info-dark: {{term_cyan}};
    --jf-palette-info-darkChannel: {{term_cyan_rgb_spaced}};
    --jf-palette-info-contrastText: {{bg}};
    --jf-palette-info-contrastTextChannel: {{bg_rgb_spaced}};

    --jf-palette-success-main: {{green}};
    --jf-palette-success-mainChannel: {{green_rgb_spaced}};
    --jf-palette-success-light: {{term_bright_green}};
    --jf-palette-success-lightChannel: {{term_bright_green_rgb_spaced}};
    --jf-palette-success-dark: {{term_green}};
    --jf-palette-success-darkChannel: {{term_green_rgb_spaced}};
    --jf-palette-success-contrastText: {{bg}};
    --jf-palette-success-contrastTextChannel: {{bg_rgb_spaced}};

    --jf-palette-text-primary: {{text}};
    --jf-palette-text-primaryChannel: {{text_rgb_spaced}};
    --jf-palette-text-secondary: {{text_subtle}};
    --jf-palette-text-secondaryChannel: {{text_subtle_rgb_spaced}};
    --jf-palette-text-disabled: {{text_faint}};
    --jf-palette-text-icon: {{text_subtle}};

    --jf-palette-divider: {{border}};
    --jf-palette-dividerChannel: {{border_rgb_spaced}};

    --jf-palette-action-active: {{text_subtle}};
    --jf-palette-action-activeChannel: {{text_subtle_rgb_spaced}};
    --jf-palette-action-hover: {{bg_hover}};
    --jf-palette-action-selected: {{bg_selected}};
    --jf-palette-action-selectedChannel: {{bg_selected_rgb_spaced}};
    --jf-palette-action-focus: {{bg_secondary_hover}};
    --jf-palette-action-disabled: {{text_faint}};
    --jf-palette-action-disabledBackground: {{bg_hover}};

    --jf-palette-starIcon-main: {{yellow}};

    --jf-palette-AppBar-defaultBg: {{bg_chrome}};
    --jf-palette-AppBar-transparentBg: rgba({{bg_chrome_rgb_csv}}, 0.6);
    --jf-palette-Alert-infoFilledBg: {{accent}};
    --jf-palette-Alert-infoFilledColor: {{text_bright}};
    --jf-palette-Button-inheritContainedBg: {{bg_hover}};
    --jf-palette-Button-inheritContainedHoverBg: {{bg_secondary_hover}};
    --jf-palette-FilledInput-bg: {{bg_hover}};
    --jf-palette-FilledInput-hoverBg: {{bg_secondary_hover}};
    --jf-palette-FilledInput-disabledBg: {{bg}};
    --jf-palette-FilledInput-borderColor: {{border}};
    --jf-palette-SnackbarContent-bg: {{bg_widget}};
    --jf-palette-SnackbarContent-color: {{text}};
    --jf-palette-Tooltip-bg: {{bg_widget}};
    --jf-palette-TableCell-border: {{border}};
    --jf-palette-Chip-defaultBorder: {{border}};
}

/* The few places Jellyfin sets a color directly. The ":root" in front makes
   these outrank Jellyfin's own rules. */

:root * {
    scrollbar-color: {{bg_secondary_hover}} {{bg}};
}

:root ::-webkit-scrollbar-track-piece {
    background-color: {{bg}};
}

:root ::-webkit-scrollbar-thumb:horizontal,
:root ::-webkit-scrollbar-thumb:vertical {
    background: {{bg_secondary_hover}};
}

/* Placeholder cards for items without artwork */
:root .defaultCardBackground1 {
    background-color: {{selection}};
}

:root .defaultCardBackground2 {
    background-color: {{accent_hover}};
}

:root .defaultCardBackground3 {
    background-color: {{accent}};
}

:root .defaultCardBackground4 {
    background-color: {{bg_selected}};
}

:root .defaultCardBackground5 {
    background-color: {{bg_secondary_hover}};
}

/* The strip under the title on an item's page */
:root .detailRibbon {
    background-color: rgba({{bg_widget_rgb_csv}}, 0.8);
    color: {{text}};
}

:root .layout-tv .detailRibbon {
    background: none;
}

/* Live TV guide */
:root .channelPrograms,
:root .guide-channelHeaderCell,
:root .programCell {
    border-color: {{border}};
}

:root .programCell-sports {
    background: rgba({{term_blue_rgb_csv}}, 0.4) !important;
}

:root .programCell-movie {
    background: rgba({{term_magenta_rgb_csv}}, 0.4) !important;
}

:root .programCell-kids {
    background: rgba({{term_cyan_rgb_csv}}, 0.4) !important;
}

:root .programCell-news {
    background: rgba({{term_green_rgb_csv}}, 0.4) !important;
}

:root .programCell-active {
    background: {{bg_selected}} !important;
}

:root .guide-programTextIcon {
    color: {{bg}};
    background: {{text_muted}};
}
