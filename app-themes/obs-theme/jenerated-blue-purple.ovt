/* Jenerated Blue Purple for OBS Studio. Generated by jenerate.py from
   style.ovt.tmpl; edit the palette or template instead of this file. */

@OBSThemeMeta {
    name: 'Jenerated Blue Purple';
    id: 'com.jenerated.blue-purple';
    extends: 'com.obsproject.Yami';
    author: 'Jenerated Themes';
    dark: 'true';
}

@OBSThemeVars {
    /* OBS's color ramps, which its stylesheet also uses directly */
    --grey1: #4b4d63;
    --grey2: #2a2c3c;
    --grey3: #363a52;
    --grey4: #1e2032;
    --grey5: #191b28;
    --grey6: #12131c;
    --grey7: #0f1019;
    --grey8: #0a0b13;

    --white1: #ffffff;
    --white2: #DBDEE1;
    --white3: #B5BAC1;
    --white4: #B5BAC1;
    --white5: #6b6f8a;

    /* Text on OBS's light style; the dark one only uses these for the
       audio meters, which are set below */
    --black1: #ffffff;
    --black2: #DBDEE1;
    --black3: #B5BAC1;
    --black4: #6b6f8a;
    --black5: #4b4d63;

    --blue1: #5865F3;
    --blue2: #5865F3;
    --blue3: #5865F3;
    --blue4: #4752c4;
    --blue5: #4752c4;
    --blue6: #3c4270;

    --red1: #f47a7d;
    --red2: #ED4246;
    --red3: #ED4246;
    --red4: #ED4246;
    --red5: #ED4246;
    --red6: #ED4246;

    --pink1: #f18cbf;
    --pink2: #EB459F;
    --pink3: #EB459F;
    --pink4: #EB459F;
    --pink5: #EB459F;
    --pink6: #EB459F;

    --purple1: #f18cbf;
    --purple2: #EB459F;
    --purple3: #EB459F;
    --purple4: #EB459F;
    --purple5: #EB459F;
    --purple6: #EB459F;

    --teal1: #8be3da;
    --teal2: #4fd1c5;
    --teal3: #4fd1c5;
    --teal4: #4fd1c5;
    --teal5: #4fd1c5;
    --teal6: #4fd1c5;

    --green1: #8bf6ac;
    --green2: #57F288;
    --green3: #57F288;
    --green4: #57F288;
    --green5: #57F288;
    --green6: #57F288;

    --yellow1: #fdf08a;
    --yellow2: #FEE75D;
    --yellow3: #FEE75D;
    --yellow4: #FEE75D;
    --yellow5: #FEE75D;
    --yellow6: #FEE75D;

    /* What each part of the window uses */
    --bg_window: #0f1019;
    --bg_base: #12131c;
    --bg_preview: #0a0b13;

    --primary: #5865F3;
    --primary_light: #4752c4;
    --primary_lighter: #5865F3;
    --primary_dark: #4752c4;
    --primary_darker: #3c4270;

    --warning: #FEE75D;
    --danger: #ED4246;

    --text: #DBDEE1;
    --text_light: #ffffff;
    --text_muted: #6b6f8a;
    --text_disabled: #4b4d63;
    --text_inactive: #DBDEE1;

    --highlight_color: #5865F3;

    --border_color: #2a2d40;

    --input_bg: #1e2032;
    --input_bg_hover: #0f1019;
    --input_bg_focus: #0f1019;
    --input_border: #2a2d40;
    --input_border_hover: #4b4d63;
    --input_border_focus: #5865F3;

    --list_item_bg_selected: #22243d;
    --list_item_bg_hover: #1e2032;

    --button_bg: #1e2032;
    --button_bg_hover: #363a52;
    --button_bg_down: #0a0b13;
    --button_bg_disabled: #12131c;
    --button_border: #1e2032;
    --button_border_hover: #4b4d63;
    --button_border_focus: #5865F3;

    --tab_bg: #12131c;
    --tab_bg_hover: #363a52;
    --tab_bg_down: #22243d;
    --tab_bg_disabled: #12131c;
    --tab_border: #2a2d40;
    --tab_border_hover: #4b4d63;
    --tab_border_focus: #5865F3;
    --tab_border_selected: #5865F3;

    --separator_hover: #ffffff;

    --scrollbar_handle: #363a52;
    --scrollbar_bg: #12131c;
    --scrollbar_hover: #4b4d63;
    --scrollbar_down: #6b6f8a;
    --scrollbar_border: #2a2d40;

    --palette_window: #0f1019;
    --palette_windowText: #DBDEE1;
    --palette_base: #12131c;
    --palette_light: #2a2c3c;
    --palette_mid: #0f1019;
    --palette_dark: #12131c;
    --palette_highlight: #5865F3;
    --palette_highlightedText: #ffffff;
    --palette_text: #DBDEE1;
    --palette_link: #7289DA;
    --palette_linkVisited: #7289DA;
    --palette_button: #1e2032;
    --palette_buttonText: #DBDEE1;
    --palette_text_active: #DBDEE1;
    --palette_text_disabled: #4b4d63;
    --palette_text_inactive: #DBDEE1;
}

/* The audio mixer's meters and labels use darker shades of each color,
   which a palette doesn't have, so these fade the palette's colors into the
   background instead. */

VolumeMeter {
    color: #6b6f8a;

    qproperty-backgroundNominalColor: rgba(87,242,136,0.3);
    qproperty-backgroundWarningColor: rgba(254,231,93,0.3);
    qproperty-backgroundErrorColor: rgba(237,66,70,0.3);
    qproperty-foregroundNominalColor: #57F288;
    qproperty-foregroundWarningColor: #FEE75D;
    qproperty-foregroundErrorColor: #ED4246;
    qproperty-magnitudeColor: #0a0b13;
    qproperty-majorTickColor: #6b6f8a;
    qproperty-minorTickColor: #4b4d63;

    qproperty-backgroundNominalColorDisabled: #1e2032;
    qproperty-backgroundWarningColorDisabled: #363a52;
    qproperty-backgroundErrorColorDisabled: #1e2032;
    qproperty-foregroundNominalColorDisabled: #6b6f8a;
    qproperty-foregroundWarningColorDisabled: #6b6f8a;
    qproperty-foregroundErrorColorDisabled: #B5BAC1;
}

.btn-mute.mute-warning {
    color: #FEE75D;
    background: rgba(254,231,93,0.2);
}

.btn-monitor.checked {
    background: rgba(87,242,136,0.35);
    color: #ffffff;
}

.btn-monitor.checked:hover {
    background: rgba(87,242,136,0.5);
    border-color: #57F288;
    color: #ffffff;
}

.toggle-hidden:checked {
    background: rgba(235,69,159,0.3);
    border-color: #EB459F;
}

VolumeControl .mixer-category {
    background: rgba(88,101,243,0.25);
    color: #ffffff;
}

VolumeControl.volume-pinned .mixer-category {
    background: rgba(88,101,243,0.45);
    color: #ffffff;
}

VolumeControl.volume-hidden .mixer-category {
    background: rgba(235,69,159,0.25);
    color: #EB459F;
}

VolumeControl.volume-unassigned .mixer-category {
    background: rgba(254,231,93,0.25);
    color: #FEE75D;
}

VolumeControl.volume-inactive .mixer-category {
    background: #0a0b13;
    color: #6b6f8a;
}

VolumeControl.volume-preview .mixer-category {
    background: rgba(87,242,136,0.25);
    color: #57F288;
}
