{
  "manifest_version": 3,
  "name": "Jenerated {{name}}",
  "version": "1.0",
  "description": "A theme generated by jenerate.py from the {{name}} palette.",
  "theme": {
    "colors": {
      "frame": [{{bg_chrome_rgb}}],
      "frame_inactive": [{{bg_chrome_rgb}}],
      "frame_incognito": [{{bg_chrome_rgb}}],
      "frame_incognito_inactive": [{{bg_chrome_rgb}}],
      "background_tab": [{{bg_chrome_rgb}}],
      "background_tab_inactive": [{{bg_chrome_rgb}}],
      "tab_text": [{{text_bright_rgb}}],
      "tab_background_text": [{{text_muted_rgb}}],
      "tab_background_text_inactive": [{{text_faint_rgb}}],
      "toolbar": [{{bg_rgb}}],
      "toolbar_text": [{{text_rgb}}],
      "toolbar_button_icon": [{{text_subtle_rgb}}],
      "bookmark_text": [{{text_subtle_rgb}}],
      "omnibox_background": [{{bg_hover_rgb}}],
      "omnibox_text": [{{text_rgb}}],
      "ntp_background": [{{bg_rgb}}],
      "ntp_text": [{{text_rgb}}],
      "ntp_link": [{{accent_soft_rgb}}],
      "ntp_header": [{{bg_chrome_rgb}}]
    },
    "properties": {
      "ntp_logo_alternate": {{scheme: "1" | "0"}}
    }
  }
}
