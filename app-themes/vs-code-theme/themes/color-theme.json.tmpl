  "tokenColors": [
    {
      "settings": {
        "foreground": "{{text}}"
      }
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "{{text_muted}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "{{green}}"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "{{orange}}"
      }
    },
    {
      "name": "Boolean / Language constant",
      "scope": ["constant.language", "constant.language.boolean", "support.constant"],
      "settings": {
        "foreground": "{{magenta}}"
      }
    },
    {
      "name": "Other constant",
      "scope": ["constant.other", "variable.other.constant", "variable.other.enummember"],
      "settings": {
        "foreground": "{{magenta}}"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.operator.logical", "storage.type.function"],
      "settings": {
        "foreground": "{{accent_soft}}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "{{accent}}"
      }
    },
    {
      "name": "Operator / Punctuation",
      "scope": ["keyword.operator", "punctuation"],
      "settings": {
        "foreground": "{{text_subtle}}"
      }
    },
    {
      "name": "Function / Method",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "{{accent_light}}"
      }
    },
    {
      "name": "Class / Type",
      "scope": ["entity.name.class", "entity.name.type", "support.class", "storage.type.class"],
      "settings": {
        "foreground": "{{cyan}}"
      }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface", "entity.other.inherited-class"],
      "settings": {
        "foreground": "{{cyan}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
      "settings": {
        "foreground": "{{text}}"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "{{orange}}"
      }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "variable.other.object.property", "support.type.property-name"],
      "settings": {
        "foreground": "{{accent_pale}}"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "{{accent}}"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "{{orange}}"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "{{yellow}}"
      }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "{{accent}}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "{{text}}",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "{{text}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "{{accent_soft}}"
      }
    },
    {
      "name": "Markup quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "{{text_muted}}",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "{{red}}",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "{{yellow}}",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON key",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "{{accent}}"
      }
    }
  ]
}
