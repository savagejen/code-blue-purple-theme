<idea-plugin>
  <id>com.github.savagejen.jenerated-themes.{{slug}}</id>
  <name>Jenerated {{name}}</name>
  <version>1.0.0</version>
  <vendor url="https://github.com/savagejen/jenerated-themes">Jenerated Themes</vendor>
  <description>Jenerated {{name}}: a dark UI theme and editor color scheme, generated by jenerate.py from the {{name}} palette.</description>
  <idea-version since-build="231"/>
  <depends>com.intellij.modules.platform</depends>

  <extensions defaultExtensionNs="com.intellij">
    <themeProvider id="jenerated-{{slug}}" path="/jenerated-{{slug}}.theme.json"/>
  </extensions>
</idea-plugin>
