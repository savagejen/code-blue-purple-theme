      "tab_selected": "#12131c",
      "tab_text": "#ffffff",
      "tab_line": "#5865F2",
      "tab_loading": "#5865F2",
      "toolbar": "#12131c",
      "toolbar_text": "#DBDEE1",
      "toolbar_top_separator": "#0a0b13",
      "toolbar_bottom_separator": "#2a2d40",
      "toolbar_vertical_separator": "#2a2d40",
      "icons": "#B5BAC1",
      "icons_attention": "#5865F2",
      "bookmark_text": "#B5BAC1",
      "button_background_hover": "#1e2032",
      "button_background_active": "#22243d",
      "toolbar_field": "#1e2032",
