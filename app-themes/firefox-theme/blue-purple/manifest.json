{
  "manifest_version": 2,
  "name": "Jenerated Blue Purple",
  "version": "1.0",
  "description": "Generated by jenerate.py from the Blue Purple palette.",
  "browser_specific_settings": {
    "gecko": {
      "id": "jenerated-blue-purple@jenerated-themes",
      "strict_min_version": "109.0"
    }
  },
  "theme": {
    "colors": {
      "frame": "#0a0b13",
      "frame_inactive": "#0a0b13",
      "tab_background_text": "#6b6f8a",
