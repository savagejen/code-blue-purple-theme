      "popup_border": "#2a2d40",
      "popup_highlight": "#22243d",
      "popup_highlight_text": "#ffffff",
      "sidebar": "#161825",
      "sidebar_text": "#B5BAC1",
      "sidebar_border": "#2a2d40",
      "sidebar_highlight": "#22243d",
      "sidebar_highlight_text": "#ffffff",
      "ntp_background": "#12131c",
      "ntp_text": "#DBDEE1"
    },
    "properties": {
      "color_scheme": "dark",
      "content_color_scheme": "system"
    }
  }
