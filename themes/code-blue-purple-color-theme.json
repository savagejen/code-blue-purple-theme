  "tokenColors": [
    {
      "settings": {
        "foreground": "#DBDEE1"
      }
    },
    {
      "name": "Comment",
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#6b6f8a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "String",
      "scope": ["string", "string.quoted", "string.template"],
      "settings": {
        "foreground": "#57F287"
      }
    },
    {
      "name": "Number",
      "scope": ["constant.numeric"],
      "settings": {
        "foreground": "#f2a65a"
      }
    },
    {
      "name": "Boolean / Language constant",
      "scope": ["constant.language", "constant.language.boolean", "support.constant"],
      "settings": {
        "foreground": "#EB459E"
      }
    },
    {
      "name": "Other constant",
      "scope": ["constant.other", "variable.other.constant", "variable.other.enummember"],
      "settings": {
        "foreground": "#EB459E"
      }
    },
    {
      "name": "Keyword",
      "scope": ["keyword", "keyword.control", "keyword.operator.logical", "storage.type.function"],
      "settings": {
        "foreground": "#7289DA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Storage",
      "scope": ["storage", "storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#5865F2"
      }
    },
    {
      "name": "Operator / Punctuation",
      "scope": ["keyword.operator", "punctuation"],
      "settings": {
        "foreground": "#B5BAC1"
      }
    },
    {
      "name": "Function / Method",
      "scope": ["entity.name.function", "support.function", "meta.function-call"],
      "settings": {
        "foreground": "#8593f5"
      }
    },
    {
      "name": "Class / Type",
      "scope": ["entity.name.class", "entity.name.type", "support.class", "storage.type.class"],
      "settings": {
        "foreground": "#4fd1c5"
      }
    },
    {
      "name": "Interface",
      "scope": ["entity.name.type.interface", "entity.other.inherited-class"],
      "settings": {
        "foreground": "#4fd1c5",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variable",
      "scope": ["variable", "variable.other.readwrite", "meta.definition.variable"],
      "settings": {
        "foreground": "#DBDEE1"
      }
    },
    {
      "name": "Parameter",
      "scope": ["variable.parameter"],
      "settings": {
        "foreground": "#f2a65a"
      }
    },
    {
      "name": "Property",
      "scope": ["variable.other.property", "variable.other.object.property", "support.type.property-name"],
      "settings": {
        "foreground": "#9cb2fa"
      }
    },
    {
      "name": "Tag",
      "scope": ["entity.name.tag", "meta.tag"],
      "settings": {
        "foreground": "#5865F2"
      }
    },
    {
      "name": "Attribute",
      "scope": ["entity.other.attribute-name"],
      "settings": {
        "foreground": "#f2a65a"
      }
    },
    {
      "name": "Regex",
      "scope": ["string.regexp"],
      "settings": {
        "foreground": "#FEE75C"
      }
    },
    {
      "name": "Markup heading",
      "scope": ["markup.heading"],
      "settings": {
        "foreground": "#5865F2",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup bold",
      "scope": ["markup.bold"],
      "settings": {
        "foreground": "#DBDEE1",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markup italic",
      "scope": ["markup.italic"],
      "settings": {
        "foreground": "#DBDEE1",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markup link",
      "scope": ["markup.underline.link", "string.other.link"],
      "settings": {
        "foreground": "#7289DA"
      }
    },
    {
      "name": "Markup quote",
      "scope": ["markup.quote"],
      "settings": {
        "foreground": "#6b6f8a",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": {
        "foreground": "#ED4245",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Deprecated",
      "scope": ["invalid.deprecated"],
      "settings": {
        "foreground": "#FEE75C",
        "fontStyle": "strikethrough"
      }
    },
    {
      "name": "JSON key",
      "scope": ["support.type.property-name.json"],
      "settings": {
        "foreground": "#5865F2"
      }
    }
  ]
}
